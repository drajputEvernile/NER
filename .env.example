# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180

# Azure Blob Storage (raw record folders)
# This account uses Microsoft Entra (account keys are disabled).
# Set AUTH=entra and ACCOUNT_NAME, then run: az login
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
# Container name from Storage browser → Blob containers
AZURE_STORAGE_CONTAINER=imaging-pipeline
# Path inside the container down to the folder that contains record folders.
# Example layout:
#   imaging-pipeline / Raw_Input / Run1 / Batch1 / Deid_Images / {RecordId} / images...
AZURE_STORAGE_PREFIX=Raw_Input/Run1/Batch1/Deid_Images
# Write destination for Azure OCR JSON / Member Verification OCR read:
#   imaging-pipeline / OCR_Processed / Batch1 / Final2 / {RecordId} / {RecordId}_final2.json
AZURE_STORAGE_WRITE_PREFIX=OCR_Processed/Batch1/Final2

# Member Verification OCR source: blob | local
OCR_SOURCE=blob

# OCR engines
DOCLING_OCR=true
AZURE_OCR=false

# NER models
GLINER_LARGE=true
GLINER_MEDIUM=true
GLINER_LOW=true
DISTILROBERTA_BASE_NER=true
