# Azure Document Intelligence (Azure_OCR/)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_POLL_TIMEOUT_SECONDS=180

# Azure Blob Storage
# This account uses Microsoft Entra (account keys are disabled).
# Set AUTH=entra and ACCOUNT_NAME, then run: az login
AZURE_STORAGE_AUTH=entra
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=imaging-pipeline
# Raw images for Azure_OCR (record folders live under this prefix)
AZURE_OCR_RAW_STORAGE_PREFIX=Raw_Input/Run1/Batch2/Deid_PNGs
# OCR JSON write (Azure_OCR) / read (Member Verification)
AZURE_OCR_STORAGE_WRITE_PREFIX=OCR_Processed/Batch1/Final2
# Optional Azure OCR parallelism (defaults: 10 records, 14 API calls)
AZURE_OCR_PARALLEL_RECORDS=10
AZURE_OCR_MAX_REQUESTS=14

# Local Docling OCR
DOCLING_OCR=true

# Member Verification paths (absolute). Override these or set in config.py.
# MV_SYSTEM_INPUT_PATH=E:\Projects\NER\Data\Raw\system_input.csv
# MV_OUTPUT_PATH=E:\Projects\NER\Data\output
# NER_OUTPUT_PATH=E:\Projects\NER\Data\output

# Member Verification run_selected: skip OCR JSON docs with more pages than this
MAX_PAGES=10

# NER models (weights under Models/)
GLINER_LARGE=true
GLINER_MEDIUM=true
GLINER_LOW=true
